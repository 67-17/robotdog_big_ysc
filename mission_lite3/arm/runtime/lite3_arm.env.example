# Copy this file to lite3_arm.env on the robot dog and adjust values there.
ARM_PORT=/dev/ttyUSB0
ARM_CAMERA=/dev/video0
ARM_WIDTH=1280
ARM_HEIGHT=720
ARM_FPS=25
ARM_BAUD=115200
ARM_TIMEOUT=2
ARM_CONFIG=strip_detector_grasp_config.json
ARM_CALIBRATION=camera_calibration.json
ARM_GRASP_REFERENCE=grasp_reference_square_face.json
ARM_PLACE_REFERENCE=place_reference.json
ARM_RUN_LOG_DIR=grasp_runs
ARM_STARTUP_POSE_FILE=moving_pose.json
ARM_STARTUP_SPD=15
ARM_STARTUP_ACC=15
